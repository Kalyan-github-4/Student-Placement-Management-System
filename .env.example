# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
# Required for `next start` outside Vercel (dev mode trusts the host automatically)
AUTH_TRUST_HOST=true

# Public URL of the app, used in links inside emails
APP_URL="http://localhost:3000"

# Email (optional in development). Without RESEND_API_KEY, emails and their
# links are printed to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="Placement Cell <kalyanmanna439@gmail.com>"
CLOUDINARY_API=""
